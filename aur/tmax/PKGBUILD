# CyberOS local package: tmax with its own bundled Electron.
# (AUR tmax-bin needs electron30, which is gone from the repos, and its node-pty
#  native module only matches that ABI — so we ship upstream's RPM as-is.)
pkgname=tmax
pkgver=1.12.1
pkgrel=1
pkgdesc="Multi-terminal app with tiling layouts, floating panels and a keyboard-driven workflow"
arch=('x86_64')
url="https://inbarr.github.io/tmax/"
license=('MIT')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libnotify' 'at-spi2-core' 'libdrm' 'mesa' 'libxkbcommon' 'python' 'bash')
provides=('tmax')
conflicts=('tmax-bin')
options=('!strip' '!emptydirs')
source=("${pkgname}-${pkgver}.rpm::https://github.com/InbarR/tmax/releases/download/v${pkgver}/${pkgname}-${pkgver}-1.x86_64.rpm")
noextract=("${pkgname}-${pkgver}.rpm")
sha256sums=('7fdb642d75e5ea734b83d16a76d15e679133da52f72c6a0340a2ef6ba0b1b6b7')

package() {
    cd "${srcdir}"
    rm -rf rpmroot && mkdir rpmroot
    bsdtar -xf "${pkgname}-${pkgver}.rpm" -C rpmroot
    local appdir
    appdir=$(dirname "$(find rpmroot -type f -name resources.pak | head -1)")
    install -d "${pkgdir}/opt" "${pkgdir}/usr/bin" "${pkgdir}/usr/share/applications" "${pkgdir}/usr/share/pixmaps"
    cp -a "${appdir}" "${pkgdir}/opt/${pkgname}"
    # drop other-platform pty prebuilds
    rm -rf "${pkgdir}/opt/${pkgname}/resources/app/node_modules/node-pty/prebuilds/"{darwin-*,win32-*} 2>/dev/null || true
    [[ -f "${pkgdir}/opt/${pkgname}/chrome-sandbox" ]] && chmod 4755 "${pkgdir}/opt/${pkgname}/chrome-sandbox"
    local exe
    exe=$(find "${pkgdir}/opt/${pkgname}" -maxdepth 1 -type f -executable -printf '%s %f\n' | sort -nr | head -1 | cut -d' ' -f2-)
    cat > "${pkgdir}/usr/bin/${pkgname}" <<SH
#!/bin/bash
export ELECTRON_OZONE_PLATFORM_HINT="\${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
exec /opt/${pkgname}/${exe} "\$@"
SH
    chmod 755 "${pkgdir}/usr/bin/${pkgname}"
    find rpmroot/usr/share/applications -name '*.desktop' -exec install -Dm644 {} -t "${pkgdir}/usr/share/applications/" \;
    find rpmroot/usr/share -path '*icons*' -o -path '*pixmaps*' | grep -E '\.(png|svg)$' | while read -r f; do
        install -Dm644 "$f" "${pkgdir}/usr/share/${f#rpmroot/usr/share/}"
    done
    sed -i -E "s|^Exec=.*|Exec=/usr/bin/${pkgname} %U|" "${pkgdir}"/usr/share/applications/*.desktop
    [[ -f "${appdir}/LICENSE" ]] && install -Dm644 "${appdir}/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}" || true
}
