# ---- firewall ----
ufw

# ---- graphics / wayland stack ----
mesa
vulkan-intel
vulkan-radeon
intel-media-driver
xorg-xwayland
qt5-wayland
qt6-wayland

# Drivers for hardware students actually own, not just what QEMU presents.
# nvidia-open supports Turing (GTX 16xx / RTX 20xx) and newer only; older cards
# fall back to nouveau and are Tier 3 in docs/SPEC.md.
nvidia-open-dkms
# Broadcom wireless is common on the older Dell and Apple laptops students bring
# and is not covered by linux-firmware.
broadcom-wl-dkms
# Several Tier 2 laptop failures are firmware bugs with an LVFS fix.
fwupd
# Power profiles (power-saver / balanced / performance) for the battery chip's
# panel. Quickshell talks to it over D-Bus; without the daemon the panel renders
# but every profile switch silently does nothing.
power-profiles-daemon
# CyberOS has no Microsoft-signed shim and cannot claim Secure Boot support, but
# sbctl lets a lab enrol its own keys rather than leaving those machines
# unbootable. docs/SPEC.md S5.
sbctl

# ---- Hyprland desktop ----
hyprland
swaybg
hyprlock
hypridle
hyprpolkitagent
xdg-desktop-portal-hyprland
# Qt file-chooser/settings portal -- hyprland's portal has no FileChooser.
# Replaces xdg-desktop-portal-gtk; /etc/xdg-desktop-portal/hyprland-portals.conf
# routes FileChooser here.
xdg-desktop-portal-kde
# removable-drive mounting for the QML file manager
udisks2
xdg-user-dirs
quickshell
grim
slurp
wl-clipboard
cliphist
# qalc (libqalculate's CLI) backs the QML calculator popup (Super+equal). It
# used to arrive transitively as rofi-calc's dependency; explicit now that
# rofi-calc is gone.
libqalculate
brightnessctl
playerctl
pamixer
kanshi

# ---- display manager ----
sddm
qt6-declarative
qt6-svg
qt6-5compat
qt5-graphicaleffects
qt5-quickcontrols2
qt5-svg

# ---- audio / bluetooth ----
pipewire
pipewire-alsa
pipewire-pulse
pipewire-jack
wireplumber
bluez
bluez-utils

# ---- terminal / editors ----
foot
foot-terminfo
tmux
neovim
python-pynvim
ripgrep
fd
fzf
lazygit

# ---- apps ----
firefox
# Firefox is also the PDF viewer (pdf.js) -- okular is gone with the rest of
# the KDE apps. Files/Images/Mixer are Quickshell QML surfaces now, so the
# only GUI apps on the ISO are the two that no QML surface can replace.
mpv
# xdg-open: how the QML file manager hands a file to its registered handler.
# Shell scripts, no toolkit dependency. Nothing else on the ISO provides it
# (dolphin used KIO internally).
xdg-utils
# trash-put: the freedesktop trash spec. `gio trash` left with gvfs, and the
# file manager must never rm a student's work.
trash-cli

# ---- virtualization ----
virtualbox
virtualbox-host-dkms
virtualbox-guest-utils
qemu-guest-agent
open-vm-tools

