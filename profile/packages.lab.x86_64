# ---- CyberOS lab edition: the security-lab toolset ----
#
# Added on top of packages.base.x86_64 when build.sh is run with --edition lab.
# These are what make the image 4.9 GiB, which is over GitHub's 2 GiB
# release-asset cap, so the base edition installs them from [cyberos-apps]
# instead of shipping them.

john
hashcat
hydra
aircrack-ng
sqlmap
nikto
gobuster
binwalk
radare2
ghidra
metasploit
exploitdb
hashcat-utils
masscan
arp-scan
bettercap
impacket
python-scapy
smbclient
nbtscan
sslscan
testssl.sh
foremost
perl-image-exiftool
sleuthkit
volatility3
yara
virtualbox
virtualbox-host-dkms
