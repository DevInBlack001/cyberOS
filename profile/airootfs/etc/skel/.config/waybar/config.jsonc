{
    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    "modules-left":   ["custom/launcher", "temperature", "custom/install"],
    "modules-center": ["clock", "hyprland/workspaces"],
    "modules-right":  ["tray", "pulseaudio", "network", "battery", "custom/power"],

    "custom/launcher": {
        "format": "󰣇",
        "on-click": "rofi -show drun",
        "tooltip": false
    },
    "temperature": {
        "format": " {temperatureC}°C",
        "critical-threshold": 85,
        "format-critical": " {temperatureC}°C",
        "interval": 5
    },
    "custom/install": {
        "exec": "test -d /run/archiso && echo '  Install CyberOS' || true",
        "interval": "once",
        "on-click": "gtk-launch cyberos-install",
        "tooltip": false
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": { "1": "󰆍", "2": "󰈹", "3": "󰨞", "4": "󰉋", "5": "󰙯", "default": "", "active": "" },
        "persistent-workspaces": { "*": 5 }
    },
    "tray": { "spacing": 8 },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " 0%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pavucontrol",
        "on-click-right": "pamixer -t",
        "tooltip": false
    },
    "network": {
        "format-wifi": " {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 offline",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}  gw {gwaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip": false
    },
    "custom/power": {
        "format": "",
        "on-click": "~/.config/rofi/powermenu.sh",
        "tooltip": false
    }
}
