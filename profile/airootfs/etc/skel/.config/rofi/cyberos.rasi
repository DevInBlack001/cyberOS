@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
}
window {
    width: 640px;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
    padding: 12px;
}
mainbox { spacing: 10px; }
inputbar {
    background-color: @surface;
    border: 1px; border-color: @border; border-radius: 6px;
    padding: 8px 12px; spacing: 8px;
    children: [ prompt, entry ];
}
prompt { text-color: @accent; }
entry { placeholder: "search…"; placeholder-color: @muted; }
listview { lines: 8; spacing: 2px; scrollbar: false; }
element { padding: 6px 10px; border-radius: 6px; spacing: 10px; }
element normal.normal { text-color: @fg; }
element selected.normal { background-color: @brand; text-color: @accent; }
element-icon { size: 22px; }
element-text { vertical-align: 0.5; }
mode-switcher { spacing: 6px; }
button { padding: 6px; border-radius: 6px; background-color: @surface; text-color: @muted; }
button selected { background-color: @brand; text-color: @accent; }
message { padding: 6px; }
