#!/usr/bin/env bash
# ============================================================================
#  cyberos-install — copy the running CyberOS live system to a disk.
#
#  The installed machine ends up IDENTICAL to the live ISO (same packages,
#  same theme), minus the live-only bits (autologin, archiso initramfs hooks).
#
#  Usage (interactive):   sudo cyberos-install
#     -> choose "Erase whole disk" (automatic layout) or "Manual" (cfdisk, pick
#        root / EFI / home partitions; keeps other operating systems).
#
#  Unattended, erase:      sudo cyberos-install --disk /dev/nvme0n1 --erase --hostname lab-07 \
#                              --user student --password 'S3cret!' --tz Africa/Accra --yes
#  Unattended, alongside:  sudo cyberos-install --disk /dev/sda --alongside --password ... --yes
#                          (uses existing free space; keeps other OSes and their ESP)
#  Unattended, manual:     sudo cyberos-install --disk /dev/sda --root /dev/sda5 --efi /dev/sda1 \
#                              [--format-efi] [--home /dev/sda6 [--format-home]] --password ... --yes
#  Other options:          --root-password P  --fs ext4|btrfs  --swap <GiB|0>
# ============================================================================

# Sourcing this file with CYBEROS_INSTALL_LIB_ONLY=1 defines the helpers without
# running the installer, so they can be tested on a host with no disks to lose.
# `set -u` is kept inside the guard too: it leaks into bats and breaks its
# internals when the file is sourced.
if [[ ${BASH_SOURCE[0]} == "${0}" ]]; then
  set -euo pipefail
fi

DISK="" MODE="" ROOTP="" EFIP="" HOMEP="" FORMAT_EFI=0 FORMAT_HOME=0
HOSTNAME_="cyberos" USER_="student" PASS="" ROOTPASS="" TZ_="UTC" FS="ext4" YES=0 SWAP_GB=4

usage() { sed -n '3,17p' "$0"; exit 1; }
die()   { echo "ERROR: $*" >&2; exit 1; }
msg()   { printf '\n\033[1;32m==> %s\033[0m\n' "$*"; }

# restore_kernel <flavour> <bootmnt> <dest>
#
# archiso keeps the kernel on the ISO rather than in the airootfs, so the copied
# root has an empty /boot and mkinitcpio fails with "must be readable". The
# default kernel is on the boot medium; linux-lts is not, but its image survives
# inside the squashfs under /usr/lib/modules.
restore_kernel() {
  local flavour=$1 bootmnt=$2 dest=$3 src

  src="$bootmnt/arch/boot/x86_64/vmlinuz-$flavour"
  if [[ -f $src ]]; then
    install -Dm644 "$src" "$dest/boot/vmlinuz-$flavour"
    return 0
  fi

  # Fall back to the copy inside the squashfs. Match on the module directory
  # suffix so "linux" never picks up the -lts image and boots the wrong kernel.
  if [[ $flavour == linux ]]; then
    src=$(find "$dest/usr/lib/modules" -maxdepth 2 -name vmlinuz 2>/dev/null \
            | grep -vE '/[^/]*-(lts|hardened|zen|rt)/vmlinuz$' | head -1)
  else
    src=$(find "$dest/usr/lib/modules" -maxdepth 2 -name vmlinuz \
            -path "*${flavour#linux-}/vmlinuz" 2>/dev/null | head -1)
  fi
  if [[ -n $src && -f $src ]]; then
    install -Dm644 "$src" "$dest/boot/vmlinuz-$flavour"
    return 0
  fi

  printf 'no kernel image found for %s (looked on the boot medium and in %s/usr/lib/modules)\n' \
    "$flavour" "$dest" >&2
  return 1
}

# grub_safe_entries <root-uuid> -- the /etc/grub.d/40_custom body.
#
# GRUB's generated entries cannot carry an extra kernel argument, so the recovery
# entries are written explicitly with the root UUID the installer already knows.
grub_safe_entries() {
  local uuid=$1
  [[ -n $uuid ]] || { printf 'grub_safe_entries: no root UUID\n' >&2; return 1; }
  cat <<ENTRIES
#!/bin/sh
exec tail -n +3 \$0
# Recovery entries. Do not remove: a student whose GPU driver fails has no other
# way back to a desktop, and one whose kernel regressed has no other way to boot.

menuentry 'CyberOS (safe graphics)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux root=UUID=$uuid rw nomodeset cyberos.safegraphics=1
    initrd /boot/initramfs-linux.img
}

menuentry 'CyberOS (LTS kernel)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux-lts root=UUID=$uuid rw
    initrd /boot/initramfs-linux-lts.img
}

menuentry 'CyberOS (LTS kernel, safe graphics)' --class cyberos {
    search --no-floppy --fs-uuid --set=root $uuid
    linux /boot/vmlinuz-linux-lts root=UUID=$uuid rw nomodeset cyberos.safegraphics=1
    initrd /boot/initramfs-linux-lts.img
}
ENTRIES
}

# Everything below this point touches disks. Stop here when sourced for tests.
if [[ -n ${CYBEROS_INSTALL_LIB_ONLY:-} ]]; then
  return 0 2>/dev/null || exit 0
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --disk) DISK=$2; shift 2;;      --hostname) HOSTNAME_=$2; shift 2;;
    --erase) MODE=erase; shift;;    --manual) MODE=manual; shift;;
    --alongside) MODE=alongside; shift;;
    --root) ROOTP=$2; MODE=manual; shift 2;;
    --efi) EFIP=$2; shift 2;;       --format-efi) FORMAT_EFI=1; shift;;
    --home) HOMEP=$2; shift 2;;     --format-home) FORMAT_HOME=1; shift;;
    --user) USER_=$2; shift 2;;     --password) PASS=$2; shift 2;;
    # Read passwords from stdin instead of argv, which is world-readable
    # in /proc: line 1 is the user password, an optional line 2 is root's.
    --password-stdin) IFS= read -r PASS; IFS= read -r ROOTPASS || true; shift;;
    --root-password) ROOTPASS=$2; shift 2;;
    --tz) TZ_=$2; shift 2;;         --fs) FS=$2; shift 2;;
    --swap) SWAP_GB=$2; shift 2;;   --yes|-y) YES=1; shift;;
    -h|--help) usage;; *) die "unknown option $1";;
  esac
done

[[ $EUID -eq 0 ]]        || die "run as root (sudo cyberos-install)"
[[ -d /run/archiso ]]    || die "this must be run from the CyberOS live ISO"
[[ $FS == ext4 || $FS == btrfs ]] || die "--fs must be ext4 or btrfs"

UEFI=0; [[ -d /sys/firmware/efi/efivars ]] && UEFI=1
echo "Firmware mode: $([[ $UEFI -eq 1 ]] && echo UEFI || echo "legacy BIOS")"
part() { if [[ $DISK == *nvme* || $DISK == *mmcblk* ]]; then echo "${DISK}p$1"; else echo "${DISK}$1"; fi; }
show_disks() { echo; lsblk -dpno NAME,SIZE,MODEL,TRAN | grep -vE 'loop|sr0|/dev/zram'; echo; }
# A filesystem written seconds ago may still be absent from the libblkid cache
# that udev populated when the partition first appeared. Refresh it before mounting.
settle_fs() { sync; udevadm settle; blkid "$1" >/dev/null 2>&1 || true; }
show_parts() { echo; lsblk -pno NAME,SIZE,FSTYPE,PARTTYPENAME,LABEL,MOUNTPOINTS "$DISK"; echo; }

# ---------------------------------------------------------------- disk + mode
if [[ -z $DISK ]]; then
  show_disks; read -rp "Target disk (e.g. /dev/sda): " DISK
fi
[[ -b $DISK ]] || die "$DISK is not a block device"
if [[ -z $MODE ]]; then
  if [[ $YES -eq 1 ]]; then MODE=erase; else
    echo
    echo "  1) Erase whole disk  — automatic layout (BIOS-boot + EFI + root). Everything on $DISK is lost."
    echo "  2) Manual            — partition $DISK yourself (cfdisk), keep other OSes, pick partitions."
    read -rp "Choose [1/2]: " m; case "$m" in 2) MODE=manual;; *) MODE=erase;; esac
  fi
fi

if [[ $MODE == manual && $YES -eq 0 ]]; then
  show_parts
  read -rp "Open cfdisk to edit the partition table of $DISK? [Y/n]: " x
  if [[ ${x:-Y} =~ ^[Yy] ]]; then
    echo "Tips: GPT disks need a 1 MiB 'BIOS boot' partition for legacy-BIOS GRUB, and an EFI System"
    echo "      partition (>=300 MiB, FAT32) for UEFI. Create a Linux filesystem partition for /."
    read -rp "Press Enter to open cfdisk..." _
    cfdisk "$DISK"; partprobe "$DISK" 2>/dev/null || true; udevadm settle
  fi
  show_parts
  while [[ -z $ROOTP || ! -b $ROOTP ]]; do read -rp "Root (/) partition (will be FORMATTED as $FS): " ROOTP; done
  if [[ $UEFI -eq 1 ]]; then
    while [[ -z $EFIP || ! -b $EFIP ]]; do read -rp "EFI System partition (e.g. ${DISK}1): " EFIP; done
    if blkid -o value -s TYPE "$EFIP" 2>/dev/null | grep -q vfat; then
      read -rp "Format $EFIP? (say n to keep an existing Windows/Linux EFI partition) [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_EFI=1
    else FORMAT_EFI=1; fi
  else
    read -rp "EFI System partition (optional, Enter to skip): " EFIP
    [[ -n $EFIP && ! -b $EFIP ]] && die "$EFIP is not a partition"
    [[ -n $EFIP ]] && { read -rp "Format $EFIP? [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_EFI=1; }
  fi
  read -rp "Separate /home partition (optional, Enter to skip): " HOMEP
  if [[ -n $HOMEP ]]; then
    [[ -b $HOMEP ]] || die "$HOMEP is not a partition"
    read -rp "Format $HOMEP? (n keeps existing data) [y/N]: " x; [[ $x =~ ^[Yy] ]] && FORMAT_HOME=1
  fi
fi
# ---------------------------------------------------------------- alongside
# Install into existing free space next to another OS. Nothing already on the
# disk is touched: no partition is deleted, moved or resized. The only write to
# the partition table is one new entry in a gap that is already free.
if [[ $MODE == alongside ]]; then
  MIN_GIB=25
  command -v sgdisk >/dev/null || die "sgdisk not found"
  [[ $(blkid -o value -s PTTYPE "$DISK") == gpt ]] ||
    die "installing alongside needs a GPT disk; $DISK is not GPT"

  # sgdisk -F/-E give the first and last aligned sector of the LARGEST free block.
  FREE_START=$(sgdisk -F "$DISK") || die "cannot read free space on $DISK"
  FREE_END=$(sgdisk -E "$DISK")   || die "cannot read free space on $DISK"
  FREE_GIB=$(( (FREE_END - FREE_START + 1) * 512 / 1024 / 1024 / 1024 ))
  echo "Largest free block on $DISK: ${FREE_GIB} GiB"
  [[ $FREE_GIB -ge $MIN_GIB ]] || die "need at least ${MIN_GIB} GiB of unallocated space, found ${FREE_GIB} GiB.
Shrink an existing partition first — from Windows use Disk Management, from
Linux use gparted — then run the installer again."

  if [[ $UEFI -eq 1 ]]; then
    # Reuse the other OS's EFI System Partition; formatting it would destroy
    # that OS's bootloader.
    EFIP=$(lsblk -pnro NAME,PARTTYPE "$DISK" | awk '$2=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}')
    [[ -n $EFIP ]] || die "no EFI System Partition found on $DISK; cannot install alongside on UEFI"
    FORMAT_EFI=0
    echo "Reusing existing EFI System Partition $EFIP (will not be formatted)"
  fi

  before=$(lsblk -pnro NAME "$DISK" | tail -n +2 | sort)
  sgdisk -n 0:0:0 -t 0:8304 -c 0:CyberOS "$DISK" >/dev/null || die "failed to create the new partition"
  partprobe "$DISK" 2>/dev/null || true; udevadm settle; sleep 1
  after=$(lsblk -pnro NAME "$DISK" | tail -n +2 | sort)
  ROOTP=$(comm -13 <(echo "$before") <(echo "$after") | head -1)
  [[ -b ${ROOTP:-/nonexistent} ]] || die "could not identify the partition just created"
  echo "Created $ROOTP for /"
  MODE=manual                      # the rest of the install is the manual path
fi

if [[ $MODE == manual ]]; then
  [[ -b ${ROOTP:-/nonexistent} ]] || die "--root <partition> is required for manual mode"
  [[ $UEFI -eq 0 || -b ${EFIP:-/nonexistent} ]] || die "--efi <partition> is required on UEFI systems"
  for p_ in $ROOTP $EFIP $HOMEP; do grep -q "^$p_ " /proc/mounts && die "$p_ is mounted — unmount it first"; done
  [[ $ROOTP != "$EFIP" && $ROOTP != "$HOMEP" ]] || die "root/efi/home must be different partitions"
else
  grep -q "^$DISK" /proc/mounts 2>/dev/null && die "$DISK is mounted — unmount it first"
fi

# ---------------------------------------------------------------- account details
if [[ $YES -eq 0 ]]; then
  read -rp "Hostname [$HOSTNAME_]: " x; HOSTNAME_=${x:-$HOSTNAME_}
  read -rp "Username [$USER_]: " x; USER_=${x:-$USER_}
  while [[ -z $PASS ]]; do read -rsp "Password for $USER_ (typing is hidden): " PASS; echo; done
  read -rsp "Root password [same as user] (hidden): " ROOTPASS; echo
  read -rp "Timezone [$TZ_]: " x; TZ_=${x:-$TZ_}
  read -rp "Filesystem ext4/btrfs [$FS]: " x; FS=${x:-$FS}
  echo
  if [[ $MODE == erase ]]; then
    lsblk "$DISK"; echo
    read -rp "Type ERASE to wipe $DISK and install CyberOS: " c; [[ $c == ERASE ]] || die "aborted"
  else
    echo "Summary:  /     -> $ROOTP  (format $FS)"
    if [[ -n $EFIP ]];  then echo "          /boot/efi -> $EFIP  ($([[ $FORMAT_EFI -eq 1 ]] && echo format || echo keep))"; fi
    if [[ -n $HOMEP ]]; then echo "          /home -> $HOMEP  ($([[ $FORMAT_HOME -eq 1 ]] && echo format || echo keep))"; fi
    read -rp "Type INSTALL to proceed: " c; [[ $c == INSTALL ]] || die "aborted"
  fi
fi
[[ -n $PASS ]] || die "--password is required with --yes"
ROOTPASS=${ROOTPASS:-$PASS}
[[ -f /usr/share/zoneinfo/$TZ_ ]] || die "unknown timezone $TZ_"
[[ $FS == ext4 || $FS == btrfs ]] || die "filesystem must be ext4 or btrfs"

# ---------------------------------------------------------------- partition (erase mode)
swapoff -a 2>/dev/null || true
if [[ $MODE == erase ]]; then
  msg "Partitioning $DISK (GPT: BIOS-boot 1M, EFI 1G, root rest)"
  wipefs -af "$DISK" >/dev/null
  sgdisk -Z "$DISK" >/dev/null
  sgdisk -n1:0:+1M   -t1:ef02 -c1:"BIOS boot" \
         -n2:0:+1G   -t2:ef00 -c2:"EFI" \
         -n3:0:0     -t3:8304 -c3:"CyberOS root" "$DISK" >/dev/null
  # Legacy BIOSes (VMware, some PCs) only boot GPT disks if the protective MBR is flagged bootable
  parted -s "$DISK" disk_set pmbr_boot on
  partprobe "$DISK"; udevadm settle; sleep 1
  EFIP=$(part 2); ROOTP=$(part 3); FORMAT_EFI=1; HOMEP=""
else
  # keep whatever table the user made; just make sure a GPT disk is BIOS-bootable too
  if [[ $(blkid -o value -s PTTYPE "$DISK" 2>/dev/null) == gpt ]]; then parted -s "$DISK" disk_set pmbr_boot on 2>/dev/null || true; fi
fi

# ---------------------------------------------------------------- format + mount
msg "Formatting"
if [[ $FS == btrfs ]]; then
  mkfs.btrfs -f -L CYBEROS "$ROOTP" >/dev/null
  settle_fs "$ROOTP"
  mount -t btrfs "$ROOTP" /mnt; btrfs subvolume create /mnt/@ >/dev/null
  if [[ -z $HOMEP ]]; then btrfs subvolume create /mnt/@home >/dev/null; fi
  umount /mnt
  mount -t btrfs -o subvol=@,compress=zstd,noatime "$ROOTP" /mnt
  mkdir -p /mnt/home
  if [[ -z $HOMEP ]]; then mount -t btrfs -o subvol=@home,compress=zstd,noatime "$ROOTP" /mnt/home; fi
else
  mkfs.ext4 -qF -L CYBEROS "$ROOTP"
  settle_fs "$ROOTP"
  mount -t ext4 "$ROOTP" /mnt
  mkdir -p /mnt/home
fi
if [[ -n $HOMEP ]]; then
  if [[ $FORMAT_HOME -eq 1 ]]; then mkfs.ext4 -qF -L CYBEROS_HOME "$HOMEP"; settle_fs "$HOMEP"; fi
  mount "$HOMEP" /mnt/home
fi
if [[ -n $EFIP ]]; then
  if [[ $FORMAT_EFI -eq 1 ]]; then mkfs.fat -F32 -n CYBEROS_EFI "$EFIP" >/dev/null; settle_fs "$EFIP"; fi
  mkdir -p /mnt/boot/efi
  # Always pass -t vfat. On a partition created moments ago, libblkid can still
  # report no filesystem, and `mount` then probes only what is already in
  # /proc/filesystems (ext4/ext3/ext2). vfat is not loaded on the live ISO, so
  # autodetection fails and set -e aborts the install just before the rsync.
  mount -t vfat "$EFIP" /mnt/boot/efi
fi

# ---------------------------------------------------------------- copy system
msg "Copying system (this takes a few minutes)"
rsync -aHAXx --info=progress2 --no-inc-recursive \
  --exclude={/dev/*,/proc/*,/sys/*,/tmp/*,/run/*,/mnt/*,/media/*,/lost+found,/boot/efi/*} \
  --exclude=/etc/mkinitcpio.conf.d/archiso.conf \
  --exclude=/etc/sddm.conf.d/zz-live-autologin.conf \
  --exclude=/etc/sudoers.d/20-live-student \
  --exclude=/etc/systemd/system/etc-pacman.d-gnupg.mount \
  --exclude=/etc/systemd/system/pacman-init.service \
  --exclude=/etc/systemd/system/multi-user.target.wants/pacman-init.service \
  --exclude=/etc/systemd/journald.conf.d/volatile-storage.conf \
  --exclude=/etc/systemd/logind.conf.d/do-not-suspend.conf \
  --exclude=/etc/systemd/system/sleep.target \
  --exclude=/etc/systemd/system/suspend.target \
  --exclude=/etc/systemd/system/hibernate.target \
  --exclude=/etc/systemd/system/hybrid-sleep.target \
  --exclude=/etc/systemd/system/suspend-then-hibernate.target \
  --exclude=/etc/systemd/resolved.conf.d/archiso.conf \
  --exclude=/etc/systemd/system-generators/systemd-gpt-auto-generator \
  --exclude=/etc/pacman.d/hooks/zzzz99-remove-custom-hooks-from-airootfs.hook \
  --exclude=/etc/motd \
  --exclude=/root/customize_airootfs.sh \
  / /mnt/
mkdir -p /mnt/{dev,proc,sys,tmp,run,mnt,media}
chmod 1777 /mnt/tmp

# ---------------------------------------------------------------- configure
msg "Configuring installed system"
echo "$HOSTNAME_" > /mnt/etc/hostname
printf '127.0.0.1 localhost\n::1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_" > /mnt/etc/hosts
rm -f /mnt/etc/resolv.conf; touch /mnt/etc/resolv.conf     # NetworkManager manages it
printf 'CyberOS \\r (\\l)\n\n' > /mnt/etc/issue
cat > /mnt/etc/motd <<'M'
  CyberOS — Cyber Department. Type `fastfetch` for system info.
M
cat > /mnt/etc/mkinitcpio.d/linux.preset <<'M'
# mkinitcpio preset file for the 'linux' package
ALL_kver="/boot/vmlinuz-linux"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
M
cat > /mnt/etc/mkinitcpio.d/linux-lts.preset <<'M'
# mkinitcpio preset file for the 'linux-lts' package
ALL_kver="/boot/vmlinuz-linux-lts"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux-lts.img"
fallback_image="/boot/initramfs-linux-lts-fallback.img"
fallback_options="-S autodetect"
M
# archiso keeps the kernel on the ISO rather than in the airootfs, so the live
# /boot is empty and the copied system has no kernel — mkinitcpio then fails with
# "'/boot/vmlinuz-linux' must be readable". Restore both; the initramfs itself is
# regenerated by mkinitcpio inside the chroot below.
restore_kernel linux /run/archiso/bootmnt /mnt || die "kernel image not found"
if ! restore_kernel linux-lts /run/archiso/bootmnt /mnt; then
  echo "WARNING: no LTS kernel found; this system will have no fallback kernel"
  rm -f /mnt/etc/mkinitcpio.d/linux-lts.preset
fi

genfstab -U /mnt > /mnt/etc/fstab

# swapfile
if [[ $SWAP_GB -gt 0 ]]; then
  if [[ $FS == btrfs ]]; then
    btrfs subvolume create /mnt/swap >/dev/null
    btrfs filesystem mkswapfile --size "${SWAP_GB}g" /mnt/swap/swapfile >/dev/null
    echo '/swap/swapfile none swap defaults 0 0' >> /mnt/etc/fstab
  else
    mkswap -U clear --size "${SWAP_GB}G" --file /mnt/swapfile >/dev/null
    echo '/swapfile none swap defaults 0 0' >> /mnt/etc/fstab
  fi
fi

# first-boot oneshot
cat > /mnt/etc/systemd/system/cyberos-firstboot.service <<'M'
[Unit]
Description=CyberOS first boot tasks
After=local-fs.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/cyberos-firstboot
[Install]
WantedBy=multi-user.target
M

# Recovery entries GRUB's generator cannot produce, because they need an extra
# kernel argument. Written here, where the root UUID is already known.
ROOT_UUID=$(blkid -o value -s UUID "$ROOTP")
if [[ -n $ROOT_UUID ]]; then
  grub_safe_entries "$ROOT_UUID" > /mnt/etc/grub.d/40_custom
  chmod 755 /mnt/etc/grub.d/40_custom
else
  echo "WARNING: no UUID for $ROOTP; skipping the recovery boot entries"
fi

msg "Finalising inside chroot"
arch-chroot /mnt /bin/bash -e <<CH
ln -sf /usr/share/zoneinfo/$TZ_ /etc/localtime
hwclock --systohc || true

# users
if [[ "$USER_" != "student" ]]; then
  useradd -m -G wheel,adm,uucp,audio,video,input,storage,vboxusers,wireshark -s /usr/bin/zsh "$USER_"
  cp -rT /etc/skel /home/$USER_ && chown -R $USER_:$USER_ /home/$USER_
  userdel -r student 2>/dev/null || true
fi
echo "$USER_:$PASS" | chpasswd
echo "root:$ROOTPASS" | chpasswd

# drop live-only pieces
pacman -Rns --noconfirm mkinitcpio-archiso >/dev/null 2>&1 || true
rm -rf /etc/mkinitcpio.conf.d/archiso.conf /etc/sddm.conf.d/zz-live-autologin.conf
# The installer only works from the live medium. Left in place it shows up in the
# launcher on an installed machine and dies with "must be run from the live ISO",
# so drop it along with its menu entry and keybind.
rm -f /usr/share/applications/cyberos-install.desktop \
      /usr/local/bin/cyberos-install /usr/local/bin/cyberos-install-gui
sed -i '/gtk-launch cyberos-install/d' /etc/skel/.config/hypr/hyprland.conf /home/*/.config/hypr/hyprland.conf 2>/dev/null || true
systemctl enable NetworkManager sddm bluetooth cyberos-firstboot >/dev/null 2>&1
systemctl disable ModemManager >/dev/null 2>&1 || true

# pacman keyring for future online updates
pacman-key --init >/dev/null 2>&1
pacman-key --populate archlinux >/dev/null 2>&1

mkinitcpio -P

# bootloader: ALWAYS install both BIOS and UEFI GRUB so the disk boots whatever the firmware mode
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="CyberOS"/' /etc/default/grub
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grub-install --target=i386-pc --recheck "$DISK" || echo "WARNING: BIOS grub-install failed (fine on UEFI-only machines)"
if mountpoint -q /boot/efi; then
  # removable path (EFI/BOOT/BOOTX64.EFI): works with no NVRAM entry, from a BIOS-booted live session too
  grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=CyberOS --removable --no-nvram --recheck
  # proper NVRAM entry when we are actually running under UEFI
  [[ $UEFI -eq 1 ]] && grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=CyberOS --recheck || true
fi
grub-mkconfig -o /boot/grub/grub.cfg
CH

msg "Done. Unmounting."
sync; umount -R /mnt
echo
echo "CyberOS installed on $DISK  (user: $USER_, host: $HOSTNAME_). Remove the USB and reboot."
