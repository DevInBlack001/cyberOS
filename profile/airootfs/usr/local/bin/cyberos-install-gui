#!/usr/bin/env python3
"""cyberos-install-gui — graphical front-end for cyberos-install.

Deliberately does no disk work of its own. It collects answers, then runs
/usr/local/bin/cyberos-install with its unattended flags and streams the output
into a log view. All partitioning, formatting, copying and bootloader logic
stays in that one audited script, so the GUI cannot drift from the CLI.

  --dry-run   render and drive the whole wizard without live media and without
              touching a disk; the install step prints the command instead.
"""
import os
import re
import shlex
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

INSTALLER = "/usr/local/bin/cyberos-install"
DRY_RUN = "--dry-run" in sys.argv


# zram and loop devices report TYPE=disk to lsblk but are not install targets:
# zram0 is compressed RAM, and offering it would let someone "install" into
# memory. Ruled out by name, since there is no type that separates them.
NOT_A_TARGET = re.compile(r"^/dev/(zram|loop|ram|sr|fd)\d")


def live_medium():
    """The disk the live session booted from — never offer to erase it."""
    src = subprocess.run(["findmnt", "-no", "SOURCE", "/run/archiso/bootmnt"],
                         capture_output=True, text=True, check=False).stdout.strip()
    if not src:
        return None
    src = src.split("[")[0]
    parent = subprocess.run(["lsblk", "-no", "PKNAME", src],
                            capture_output=True, text=True,
                            check=False).stdout.strip().splitlines()
    return f"/dev/{parent[0]}" if parent and parent[0] else src


def list_disks():
    """Whole disks only — no partitions, no zram/loop, not the live medium."""
    out = subprocess.run(
        ["lsblk", "-dnpo", "NAME,SIZE,TYPE,MODEL"],
        capture_output=True, text=True, check=False,
    ).stdout
    boot = live_medium()
    disks = []
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3 or parts[2] != "disk":
            continue
        name, size = parts[0], parts[1]
        if NOT_A_TARGET.match(name) or name == boot:
            continue
        model = parts[3].strip() if len(parts) > 3 else ""
        disks.append((name, size, model))
    return disks


def free_space_gib(disk):
    """Size of the largest unallocated block, as the installer measures it."""
    try:
        first = int(subprocess.run(["sgdisk", "-F", disk], capture_output=True,
                                   text=True, check=True).stdout.strip())
        last = int(subprocess.run(["sgdisk", "-E", disk], capture_output=True,
                                  text=True, check=True).stdout.strip())
    except (OSError, ValueError, subprocess.CalledProcessError):
        return 0
    return max(0, (last - first + 1) * 512 // 2 ** 30)


def partitions(disk):
    """(device, size, fstype, label) for each partition on the disk."""
    out = subprocess.run(
        ["lsblk", "-pnro", "NAME,SIZE,FSTYPE,PARTTYPENAME", disk],
        capture_output=True, text=True, check=False).stdout
    rows = []
    for line in out.splitlines()[1:]:
        f = line.split(None, 3)
        if len(f) >= 2:
            rows.append((f[0], f[1], f[2] if len(f) > 2 else "",
                         f[3] if len(f) > 3 else ""))
    return rows


def timezones():
    try:
        out = subprocess.run(["timedatectl", "list-timezones"],
                             capture_output=True, text=True, check=False).stdout
        zones = [z for z in out.split() if "/" in z]
        if zones:
            return zones
    except OSError:
        pass
    return ["UTC", "Africa/Accra"]


class Wizard(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="Install CyberOS",
                         default_width=720, default_height=560)
        self.disks = list_disks()
        self.proc = None

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT)
        self.back = Gtk.Button(label="Back")
        self.next = Gtk.Button(label="Next", css_classes=["suggested-action"])
        self.back.connect("clicked", self.on_back)
        self.next.connect("clicked", self.on_next)

        header = Adw.HeaderBar()
        header.pack_start(self.back)
        header.pack_end(self.next)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        box.append(header)
        box.append(self.stack)
        self.stack.set_vexpand(True)
        self.set_content(box)

        self.mode = "erase"
        self.pages = ["welcome", "disk", "mode", "custom", "account", "options",
                      "confirm", "install", "done"]
        # Set before the pages are built: constructing the mode page activates a
        # radio, whose handler calls back into sync_buttons() and needs these.
        self.index = 0
        for name, build in (
            ("welcome", self.page_welcome), ("disk", self.page_disk),
            ("mode", self.page_mode), ("custom", self.page_custom),
            ("account", self.page_account), ("options", self.page_options),
            ("confirm", self.page_confirm), ("install", self.page_install),
            ("done", self.page_done),
        ):
            self.stack.add_named(build(), name)
        self.sync_buttons()

    # ---------------------------------------------------------------- pages
    def _page(self, title, subtitle, child=None):
        page = Adw.StatusPage(title=title, description=subtitle)
        if child is not None:
            # Clamp form content to a readable column instead of letting rows
            # stretch the full width of the screen.
            page.set_child(Adw.Clamp(maximum_size=600,
                                     tightening_threshold=400, child=child))
        return page

    def page_welcome(self):
        msg = ("This will install CyberOS onto a disk in this machine.\n\n"
               "Everything on the disk you choose will be erased.")
        if DRY_RUN:
            msg += "\n\nDRY RUN — nothing will be written."
        return self._page("Install CyberOS", msg)

    def page_disk(self):
        self.disk_list = Gtk.StringList()
        for name, size, model in self.disks:
            # Keep the label short. A long model string in a row suffix squeezes
            # the row's own title down to a single wrapped character column.
            label = f"{name}  ({size})"
            if model:
                label += f"  {model[:22]}"
            self.disk_list.append(label)
        if not self.disks:
            self.disk_list.append("no disks found")
        # ComboRow rather than ActionRow + DropDown: it lays the selected value
        # out properly instead of fighting the title for width.
        self.disk_row = Adw.ComboRow(title="Install to",
                                     subtitle="The entire disk will be erased",
                                     model=self.disk_list)
        group = Adw.PreferencesGroup(title="Target disk")
        group.add(self.disk_row)
        return self._page("Choose a disk", None, group)

    def page_mode(self):
        # Created before the radios: set_active() below fires toggled, which
        # writes to this label.
        self.mode_hint = Gtk.Label(wrap=True, css_classes=["dim-label"])
        group = Adw.PreferencesGroup(title="What should the installer do?")
        self.mode_buttons = {}
        first = None
        for key, title, subtitle in (
            ("alongside", "Install alongside",
             "Use existing free space. Other operating systems and their files "
             "are left alone."),
            ("erase", "Erase the whole disk",
             "Everything currently on the disk is destroyed."),
            ("manual", "Custom partitioning",
             "Choose which existing partitions to use."),
        ):
            row = Adw.ActionRow(title=title, subtitle=subtitle)
            btn = Gtk.CheckButton()
            if first is None:
                first = btn
            else:
                btn.set_group(first)
            btn.connect("toggled", self.on_mode_toggled, key)
            row.add_prefix(btn)
            row.set_activatable_widget(btn)
            group.add(row)
            self.mode_buttons[key] = btn
        self.mode_buttons["erase"].set_active(True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(group)
        box.append(self.mode_hint)
        return self._page("Installation type", None, box)

    def on_mode_toggled(self, button, key):
        if button.get_active():
            self.mode = key
            self.refresh_mode_hint()
            self.sync_buttons()

    def refresh_mode_hint(self):
        if not self.disks:
            return
        disk = self.selected_disk()
        if self.mode == "alongside":
            gib = free_space_gib(disk)
            if gib < 25:
                self.mode_hint.set_text(
                    f"Only {gib} GiB of unallocated space on {disk}. At least "
                    "25 GiB is needed. Shrink an existing partition first — "
                    "Disk Management on Windows, gparted on Linux — then come back.")
            else:
                self.mode_hint.set_text(
                    f"{gib} GiB of free space on {disk} will be used. Existing "
                    "partitions are not resized or deleted.")
        elif self.mode == "erase":
            self.mode_hint.set_text(f"Every partition on {disk} will be destroyed.")
        else:
            self.mode_hint.set_text("")

    def page_custom(self):
        group = Adw.PreferencesGroup(
            title="Existing partitions",
            description="Partition the disk first with a tool like cfdisk if needed.")
        self.part_root = Adw.ComboRow(title="Root (/)",
                                      subtitle="Will be formatted")
        self.part_efi = Adw.ComboRow(title="EFI system partition")
        self.fmt_efi = Gtk.Switch(valign=Gtk.Align.CENTER)
        efi_fmt_row = Adw.ActionRow(
            title="Format the EFI partition",
            subtitle="Leave off to keep another OS's bootloader")
        efi_fmt_row.add_suffix(self.fmt_efi)
        for w in (self.part_root, self.part_efi, efi_fmt_row):
            group.add(w)
        self.custom_hint = Gtk.Label(css_classes=["error"], visible=False, wrap=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(group)
        box.append(self.custom_hint)
        return self._page("Choose partitions", None, box)

    def validate_custom(self):
        if not getattr(self, "part_devices", None):
            problem = "No partitions on this disk. Create some first."
        elif (self.part_root.get_selected() == self.part_efi.get_selected()):
            problem = "Root and the EFI partition must be different partitions."
        else:
            problem = None
        self.custom_hint.set_text(problem or "")
        self.custom_hint.set_visible(problem is not None)
        return problem is None

    def refresh_partitions(self):
        parts = partitions(self.selected_disk())
        self.part_devices = [p[0] for p in parts]
        labels = Gtk.StringList()
        efi_labels = Gtk.StringList()
        for dev, size, fstype, ptype in parts:
            text = f"{dev}  ({size})" + (f"  {fstype}" if fstype else "")
            labels.append(text)
            efi_labels.append(text)
        if not parts:
            labels.append("no partitions found")
            efi_labels.append("no partitions found")
        self.part_root.set_model(labels)
        self.part_efi.set_model(efi_labels)
        esp = next((i for i, pt in enumerate(parts) if "EFI" in pt[3]), None)
        if esp is not None:
            self.part_efi.set_selected(esp)
        # Default root to something that is not the ESP, so the wizard never
        # opens with the same partition selected for both.
        root = next((i for i, pt in enumerate(parts) if i != esp), 0)
        self.part_root.set_selected(root)

    def page_account(self):
        group = Adw.PreferencesGroup(title="Account")
        self.e_user = Adw.EntryRow(title="Username", text="student")
        self.e_host = Adw.EntryRow(title="Computer name", text="cyberos")
        self.e_pass = Adw.PasswordEntryRow(title="Password")
        self.e_pass2 = Adw.PasswordEntryRow(title="Confirm password")
        for w in (self.e_user, self.e_host, self.e_pass, self.e_pass2):
            group.add(w)
        self.account_hint = Gtk.Label(css_classes=["error"], visible=False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(group)
        box.append(self.account_hint)
        return self._page("Create your account", None, box)

    def page_options(self):
        group = Adw.PreferencesGroup(title="Options")
        self.tz_list = Gtk.StringList()
        zones = timezones()
        for z in zones:
            self.tz_list.append(z)
        self.tz_row = Adw.ComboRow(title="Time zone", model=self.tz_list)
        default_tz = "Africa/Accra" if "Africa/Accra" in zones else "UTC"
        self.tz_row.set_selected(zones.index(default_tz))

        self.fs_list = Gtk.StringList()
        for f in ("ext4", "btrfs"):
            self.fs_list.append(f)
        self.fs_row = Adw.ComboRow(title="Filesystem", model=self.fs_list)

        self.swap = Gtk.SpinButton.new_with_range(0, 64, 1)
        self.swap.set_value(4)
        swap_row = Adw.ActionRow(title="Swap file", subtitle="GiB, 0 for none")
        swap_row.add_suffix(self.swap)

        self.encrypt = Adw.SwitchRow(
            title="Encrypt this disk",
            subtitle="LUKS2. You will be asked for this passphrase at every boot.")
        self.e_luks = Adw.PasswordEntryRow(title="Encryption passphrase")
        self.e_luks2 = Adw.PasswordEntryRow(title="Confirm passphrase")
        self.e_luks.set_sensitive(False)
        self.e_luks2.set_sensitive(False)
        self.encrypt.connect("notify::active", self.on_encrypt_toggled)

        self.luks_hint = Gtk.Label(xalign=0, wrap=True)
        self.luks_hint.add_css_class("dim-label")
        self.luks_hint.add_css_class("caption")

        for w in (self.tz_row, self.fs_row, swap_row,
                  self.encrypt, self.e_luks, self.e_luks2):
            group.add(w)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(group)
        box.append(self.luks_hint)
        return self._page("Options", None, box)

    def on_encrypt_toggled(self, *_):
        on = self.encrypt.get_active()
        self.e_luks.set_sensitive(on)
        self.e_luks2.set_sensitive(on)
        if not on:
            self.e_luks.set_text("")
            self.e_luks2.set_text("")
            self.luks_hint.set_text("")

    def validate_encryption(self):
        """An unlockable disk has no recovery path, so this is checked hard."""
        if not self.encrypt.get_active():
            self.luks_hint.set_text("")
            return True
        pw, pw2 = self.e_luks.get_text(), self.e_luks2.get_text()
        problem = None
        if not pw:
            problem = "An empty passphrase would produce a disk nobody can open."
        elif pw != pw2:
            problem = "The passphrases do not match."
        elif len(pw) < 8:
            problem = "Use at least 8 characters; this is the only thing protecting the disk."
        self.luks_hint.set_text(problem or "")
        return problem is None

    def page_confirm(self):
        self.summary = Gtk.Label(justify=Gtk.Justification.LEFT, xalign=0,
                                 selectable=True)
        self.agree = Gtk.CheckButton(label="I understand and want to continue")
        self.agree.connect("toggled", lambda *_: self.sync_buttons())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.append(self.summary)
        box.append(self.agree)
        return self._page("Ready to install", None, box)

    def page_install(self):
        self.log = Gtk.TextView(editable=False, monospace=True,
                                wrap_mode=Gtk.WrapMode.WORD_CHAR)
        scroll = Gtk.ScrolledWindow(vexpand=True, hexpand=True, child=self.log)
        self.progress = Gtk.ProgressBar(show_text=True, text="Preparing…")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.append(self.progress)
        box.append(scroll)
        box.set_margin_top(12); box.set_margin_bottom(12)
        box.set_margin_start(12); box.set_margin_end(12)
        return box

    def page_done(self):
        self.done_page = self._page("Installation complete",
                                    "Remove the USB stick after the machine "
                                    "has shut down, then start it again.")
        reboot = Gtk.Button(label="Restart now",
                            css_classes=["suggested-action", "pill"],
                            halign=Gtk.Align.CENTER)
        reboot.connect("clicked", lambda *_: subprocess.Popen(
            ["sudo", "-n", "systemctl", "reboot"]))
        self.done_page.set_child(reboot)
        return self.done_page

    # ------------------------------------------------------------ navigation
    @property
    def page(self):
        return self.pages[self.index]

    def sync_buttons(self):
        self.back.set_visible(self.page not in ("welcome", "install", "done"))
        self.next.set_visible(self.page not in ("install", "done"))
        if self.page == "confirm":
            self.next.set_label("Install")
            self.next.set_sensitive(self.agree.get_active())
        elif self.page == "mode":
            self.next.set_label("Next")
            self.refresh_mode_hint()
            enough = (self.mode != "alongside"
                      or free_space_gib(self.selected_disk()) >= 25)
            self.next.set_sensitive(enough)
        else:
            self.next.set_label("Next")
            self.next.set_sensitive(True)

    def skipped(self, name):
        """The partition picker is only meaningful for custom partitioning."""
        return name == "custom" and self.mode != "manual"

    def on_back(self, *_):
        while self.index > 0:
            self.index -= 1
            if not self.skipped(self.page):
                break
        self.stack.set_visible_child_name(self.page)
        self.sync_buttons()

    def on_next(self, *_):
        if self.page == "disk" and not self.disks:
            return
        if self.page == "mode":
            if self.mode == "alongside" and free_space_gib(self.selected_disk()) < 25:
                return          # hint on the page already explains why
            if self.mode == "manual":
                self.refresh_partitions()
        if self.page == "custom" and not self.validate_custom():
            return
        if self.page == "account" and not self.validate_account():
            return
        if self.page == "options":
            if not self.validate_encryption():
                return
            self.fill_summary()
        while self.index < len(self.pages) - 1:
            self.index += 1
            if not self.skipped(self.page):
                break
        self.stack.set_visible_child_name(self.page)
        self.sync_buttons()
        if self.page == "install":
            self.start_install()

    def validate_account(self):
        user = self.e_user.get_text().strip()
        pw, pw2 = self.e_pass.get_text(), self.e_pass2.get_text()
        problem = None
        if not re.fullmatch(r"[a-z_][a-z0-9_-]*", user):
            problem = "Username must be lowercase letters, digits, - or _"
        elif not pw:
            problem = "Password cannot be empty"
        elif pw != pw2:
            problem = "Passwords do not match"
        elif not self.e_host.get_text().strip():
            problem = "Computer name cannot be empty"
        self.account_hint.set_text(problem or "")
        self.account_hint.set_visible(problem is not None)
        return problem is None

    def selected_disk(self):
        return self.disks[self.disk_row.get_selected()][0]

    def fill_summary(self):
        name, size, model = self.disks[self.disk_row.get_selected()]
        what = {
            "alongside": "install alongside, using free space only",
            "erase": "ERASE the whole disk",
            "manual": "use the partitions chosen",
        }[self.mode]
        self.summary.set_markup(
            f"<b>Action</b>\t{what}\n"
            f"<b>Disk</b>\t{GLib.markup_escape_text(name)}  {size}  "
            f"{GLib.markup_escape_text(model)}\n"
            f"<b>User</b>\t{GLib.markup_escape_text(self.e_user.get_text())}\n"
            f"<b>Name</b>\t{GLib.markup_escape_text(self.e_host.get_text())}\n"
            f"<b>Zone</b>\t{self.tz_list.get_string(self.tz_row.get_selected())}\n"
            f"<b>Disk format</b>\t{self.fs_list.get_string(self.fs_row.get_selected())}"
            f", {int(self.swap.get_value())} GiB swap")

    # --------------------------------------------------------------- install
    def argv(self):
        if self.mode == "manual":
            mode_args = ["--root", self.part_devices[self.part_root.get_selected()],
                         "--efi", self.part_devices[self.part_efi.get_selected()]]
            if self.fmt_efi.get_active():
                mode_args.append("--format-efi")
        else:
            mode_args = ["--alongside" if self.mode == "alongside" else "--erase"]
        return [
            "sudo", "-n", INSTALLER,
            "--disk", self.selected_disk(), *mode_args,
            "--user", self.e_user.get_text().strip(),
            "--hostname", self.e_host.get_text().strip(),
            "--tz", self.tz_list.get_string(self.tz_row.get_selected()),
            "--fs", self.fs_list.get_string(self.fs_row.get_selected()),
            "--swap", str(int(self.swap.get_value())),
            *(["--encrypt"] if self.encrypt.get_active() else []),
            "--password-stdin", "--yes",
        ]

    def append(self, text):
        buf = self.log.get_buffer()
        buf.insert(buf.get_end_iter(), text)
        self.log.scroll_to_mark(buf.create_mark(None, buf.get_end_iter(), False),
                                0, False, 0, 0)

    def start_install(self):
        self.progress.set_text("Installing…")
        self.progress.pulse()
        GLib.timeout_add(200, self.pulse)

        if DRY_RUN:
            self.append("DRY RUN — would run:\n\n" +
                        " ".join(shlex.quote(a) for a in self.argv()) +
                        "\n\n(password supplied on stdin, not on the command line)\n")
            self.finish(0)
            return

        launcher = Gio.SubprocessLauncher.new(
            Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_MERGE |
            Gio.SubprocessFlags.STDIN_PIPE)
        try:
            self.proc = launcher.spawnv(self.argv())
        except GLib.Error as exc:
            self.append(f"Failed to start the installer: {exc.message}\n")
            self.finish(1)
            return

        # Line 1 user password, line 2 root's (empty means "same as the user's"),
        # line 3 the LUKS passphrase. All on stdin: argv is world-readable
        # through /proc/*/cmdline.
        secrets = self.e_pass.get_text() + "\n" + "\n"
        if self.encrypt.get_active():
            secrets += self.e_luks.get_text() + "\n"
        stdin = self.proc.get_stdin_pipe()
        stdin.write_all(secrets.encode(), None)
        stdin.close(None)

        stream = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self.read_line(stream)
        self.proc.wait_async(None, self.on_exit)

    def read_line(self, stream):
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self.on_line, stream)

    def on_line(self, stream, res, _data):
        try:
            line, _ = stream.read_line_finish(res)
        except GLib.Error:
            return
        if line is None:
            return
        self.append(line.decode(errors="replace") + "\n")
        self.read_line(stream)

    def on_exit(self, proc, res):
        try:
            proc.wait_finish(res)
            code = proc.get_exit_status()
        except GLib.Error:
            code = 1
        self.finish(code)

    def pulse(self):
        if self.page == "install" and self.progress.get_text() == "Installing…":
            self.progress.pulse()
            return True
        return False

    def finish(self, code):
        if code == 0:
            self.progress.set_fraction(1.0)
            self.progress.set_text("Done")
            self.index = self.pages.index("done")
            self.stack.set_visible_child_name(self.page)
            self.sync_buttons()
        else:
            self.progress.set_fraction(1.0)
            self.progress.set_text(f"Failed (exit {code})")
            self.append(f"\nInstallation FAILED with exit code {code}.\n"
                        "The error is in the output above.\n")
            self.back.set_visible(True)
            self.back.set_label("Close")
            self.back.connect("clicked", lambda *_: self.close())


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id="gh.edbron.cyberos.Installer")

    def do_activate(self):
        # libadwaita defaults to light regardless of the desktop, so ask
        # explicitly. Follow whatever cyberos-theme last set, defaulting to dark
        # like the rest of CyberOS, so the wizard is never a white window over a
        # dark desktop (or the reverse).
        mode = "dark"
        try:
            state = os.path.expanduser("~/.config/cyberos/mode")
            with open(state) as fh:
                mode = fh.read().strip() or "dark"
        except OSError:
            pass
        Adw.StyleManager.get_default().set_color_scheme(
            Adw.ColorScheme.FORCE_DARK if mode == "dark" else Adw.ColorScheme.FORCE_LIGHT)
        Wizard(self).present()


def main():
    if not DRY_RUN and not os.path.isdir("/run/archiso"):
        # Same guard the CLI installer uses; without it this would offer to
        # erase a disk on an already-installed machine.
        dialog = Gtk.AlertDialog(
            message="CyberOS is already installed",
            detail="The installer only runs from the CyberOS live USB.")
        app = Gtk.Application(application_id="gh.edbron.cyberos.Installer")
        app.connect("activate", lambda a: dialog.show(None))
        sys.exit(app.run([]))
    sys.exit(App().run([]))


if __name__ == "__main__":
    main()
