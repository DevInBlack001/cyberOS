#!/usr/bin/env bash
# ============================================================================
#  cyberos-theme — switch CyberOS between light and dark.
#
#      cyberos-theme            show the current mode
#      cyberos-theme light
#      cyberos-theme dark
#      cyberos-theme toggle
#
#  One palette lives here and every application's colours are generated from
#  it, so quickshell, foot, tmux, Neovim and Hyprland cannot
#  drift apart.
#
#  Palette: the macOS window UI scheme —
#      Red Shimmer #FF605C   Coronation Gold #FFBD44   Malachite #00CA4E
#      Light Silver #E1DFE1  Argent #C0BFC0            Tech White #F5F5F5
#
#  Those six are accents plus light neutrals. A usable desktop also needs a
#  readable text colour on white, and backgrounds for dark mode, so two
#  neutrals are derived in the same flat style. ANSI terminals need eight hues
#  where the palette gives three, so blue/magenta/cyan follow macOS system
#  colours.
# ============================================================================
set -euo pipefail

MODE="${1:-}"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="$CFG/cyberos/mode"

current() { [[ -r $STATE ]] && cat "$STATE" || echo dark; }

case "$MODE" in
  "")         current; exit 0;;
  toggle)     MODE=$([[ $(current) == dark ]] && echo light || echo dark);;
  light|dark) ;;
  *) echo "usage: cyberos-theme [light|dark|toggle]" >&2; exit 1;;
esac

RED=FF605C; GOLD=FFBD44; GREEN=00CA4E
SILVER=E1DFE1; ARGENT=C0BFC0; WHITE=F5F5F5
BLUE=0A84FF; MAGENTA=BF5AF2; CYAN=5AC8FA

if [[ $MODE == light ]]; then
  BG=$WHITE; SURFACE=$SILVER; BORDER=$ARGENT
  FG=1D1D1F; MUTED=6E6E73; SEL=$SILVER
  BAR_ALPHA=0.92; TERM_ALPHA=1.0
else
  BG=1D1D1F; SURFACE=2B2B2D; BORDER=3A3A3C
  FG=$WHITE; MUTED=$ARGENT; SEL=3A3A3C
  BAR_ALPHA=0.88; TERM_ALPHA=0.92
fi
ACCENT=$GREEN; ACCENT2=$GOLD; ALERT=$RED

mkdir -p "$CFG"/hypr "$CFG"/foot "$CFG"/tmux "$CFG"/nvim/lua "$CFG"/cyberos "$CFG"/quickshell

cat > "$CFG/hypr/theme.conf" <<T
# Generated by cyberos-theme ($MODE)
\$bg      = rgb($BG)
\$surface = rgb($SURFACE)
\$fg      = rgb($FG)
\$accent  = rgb($ACCENT)
\$accent2 = rgb($ACCENT2)
\$alert   = rgb($ALERT)
\$border  = rgb($BORDER)
\$brand   = rgb($ACCENT)
T

# Hyprland itself reads the Lua form; theme.conf above stays for hyprlock,
# which still speaks hyprlang.
cat > "$CFG/hypr/theme.lua" <<T
-- Generated by cyberos-theme ($MODE). Do not edit; run cyberos-theme instead.
return {
  mode    = "$MODE",
  bg      = "rgb($BG)",
  surface = "rgb($SURFACE)",
  fg      = "rgb($FG)",
  accent  = "rgb($ACCENT)",
  accent2 = "rgb($ACCENT2)",
  alert   = "rgb($ALERT)",
  border  = "rgb($BORDER)",
  brand   = "rgb($ACCENT)",
}
T

# foot 1.27 deprecates a bare [colors] in favour of [colors-light]/[colors-dark],
# which it selects from the desktop colour-scheme preference this script sets.
# Emit both, so foot follows the toggle without a restart and stays quiet.
foot_colors() {   # $1 = section, $2 = bg, $3 = fg, $4 = muted, $5 = sel, $6 = alpha
  cat <<C

[$1]
alpha=$6
background=$2
foreground=$3
regular0=$3
regular1=$RED
regular2=$GREEN
regular3=$GOLD
regular4=$BLUE
regular5=$MAGENTA
regular6=$CYAN
regular7=$4
bright0=$4
bright1=$RED
bright2=$GREEN
bright3=$GOLD
bright4=$BLUE
bright5=$MAGENTA
bright6=$CYAN
bright7=$3
selection-background=$5
selection-foreground=$3
C
}

{
  cat <<T
# Generated by cyberos-theme ($MODE)
font=JetBrainsMono Nerd Font:size=11
pad=10x10
dpi-aware=no

[scrollback]
lines=10000

[cursor]
style=beam
blink=yes
T
  # Both sections get the ACTIVE palette on purpose. foot picks between
  # colors-light and colors-dark using the desktop appearance portal, and with
  # no portal running it silently defaults to dark — which showed up as a dark
  # terminal in light mode. Writing the same colours to both makes the choice
  # irrelevant, while still avoiding the deprecated bare [colors].
  foot_colors colors-light "$BG" "$FG" "$MUTED" "$SEL" "$TERM_ALPHA"
  foot_colors colors-dark  "$BG" "$FG" "$MUTED" "$SEL" "$TERM_ALPHA"
} > "$CFG/foot/foot.ini"

cat > "$CFG/tmux/theme.conf" <<T
# Generated by cyberos-theme ($MODE)
set -g status-style "bg=#$SURFACE,fg=#$FG"
set -g status-left "#[bg=#$ACCENT,fg=#$BG,bold]  #S #[bg=#$SURFACE] "
set -g status-right "#[fg=#$ACCENT]%H:%M #[fg=#$MUTED]%d %b "
setw -g window-status-format "#[fg=#$MUTED] #I:#W "
setw -g window-status-current-format "#[fg=#$ACCENT2,bold] #I:#W "
set -g pane-border-style "fg=#$BORDER"
set -g pane-active-border-style "fg=#$ACCENT"
T

cat > "$CFG/nvim/lua/cyber_colors.lua" <<T
-- Generated by cyberos-theme ($MODE)
return {
  bg = "#$BG", surface = "#$SURFACE", fg = "#$FG", muted = "#$MUTED",
  accent = "#$ACCENT", accent2 = "#$ACCENT2", alert = "#$ALERT",
  border = "#$BORDER", sel = "#$SEL", blue = "#$BLUE", cyan = "#$CYAN",
  dark = $([[ $MODE == dark ]] && echo true || echo false),
}
T

# The Quickshell shell watches this file and re-themes live -- no restart.
cat > "$CFG/quickshell/theme.json" <<T
{
  "mode": "$MODE", "bg": "#$BG", "surface": "#$SURFACE", "fg": "#$FG",
  "muted": "#$MUTED", "accent": "#$ACCENT", "accent2": "#$ACCENT2",
  "alert": "#$ALERT", "border": "#$BORDER", "sel": "#$SEL", "barAlpha": $BAR_ALPHA
}
T

WALL=/usr/share/backgrounds/cyberos/wallpaper-$MODE.png
[[ -f $WALL ]] || WALL=/usr/share/backgrounds/cyberos/wallpaper.png
printf '%s\n' "$MODE" > "$STATE"

# GNOME's settings CLI left with the GNOME packages. Firefox (GTK3) reads
# settings.ini directly; Qt apps follow qt6ct's palette. Neither picks the
# change up until the app restarts -- same as the old settings-daemon path
# without a settings portal.
GTK3INI=$CFG/gtk-3.0/settings.ini
[[ -f $GTK3INI ]] && sed -i \
  "s/^gtk-application-prefer-dark-theme=.*/gtk-application-prefer-dark-theme=$([[ $MODE == dark ]] && echo 1 || echo 0)/" \
  "$GTK3INI"
QT6CT_SCHEME=/usr/share/qt6ct/colors/$([[ $MODE == dark ]] && echo darker || echo airy).conf
[[ -f $QT6CT_SCHEME && -f $CFG/qt6ct/qt6ct.conf ]] && sed -i \
  "s#^color_scheme_path=.*#color_scheme_path=$QT6CT_SCHEME#" "$CFG/qt6ct/qt6ct.conf"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null 2>&1 || true
  pkill -x swaybg >/dev/null 2>&1 || true
  (setsid swaybg -m fill -i "$WALL" >/dev/null 2>&1 &)
  # The quickshell bar is not restarted: Theme.qml watches theme.json (below)
  # and re-themes live, so there is nothing to pkill/relaunch here -- the
  # notification popups (notify/NotifyCard.qml) are part of that same shell
  # and re-theme the same way, with no separate reload command needed.
fi
tmux source-file "$CFG/tmux/theme.conf" >/dev/null 2>&1 || true

echo "CyberOS theme: $MODE"
echo "Open terminals keep their colours; new ones pick them up."
