[General]
# The pixie greeter paints a large clock and the password field over the centre
# of the screen, which collided with the wordmark on the desktop wallpaper.
# This variant is the same artwork with the centred CYBER/DEPARTMENT block removed.
background=/usr/share/backgrounds/cyberos/wallpaper-login.png
accentColor=#FFCB06
autoColor=false
use24HourClock=true
backgroundColor=#0B1610
textColor=#ECF1EE
fontFamily=JetBrainsMono Nerd Font
